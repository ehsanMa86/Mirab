#ifndef MIRAB_CONFIG_H
#define MIRAB_CONFIG_H

#define MIRAB_VERSION_STRING "@PROJECT_VERSION@"
#define MIRAB_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define MIRAB_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define MIRAB_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define MIRAB_HOMEPAGE "@PROJECT_HOMEPAGE_URL@"
#define MIRAB_COPYRIGHT "@MIRAB_COPYRIGHT@"
#define MIRAB_VENDOR "@MIRAB_VENDOR@"

/* Engine folders searched relative to the executable, in order. */
#define MIRAB_ENGINE_RELATIVE_DIRS "engines;../lib/mirab/engines;../lib64/mirab/engines;../Frameworks/engines"

#endif
