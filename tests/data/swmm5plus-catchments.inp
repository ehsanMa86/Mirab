[TITLE]
Three subcatchments draining a small storm sewer

[OPTIONS]
;;Option             Value
FLOW_UNITS           CFS
INFILTRATION         HORTON
FLOW_ROUTING         DYNWAVE
LINK_OFFSETS         DEPTH
MIN_SLOPE            0
ALLOW_PONDING        NO
SKIP_STEADY_STATE    NO
START_DATE           06/01/2024
START_TIME           00:00:00
REPORT_START_DATE    06/01/2024
REPORT_START_TIME    00:00:00
END_DATE             06/01/2024
END_TIME             02:00:00
SWEEP_START          01/01
SWEEP_END            12/31
DRY_DAYS             5
REPORT_STEP          00:05:00
WET_STEP             00:01:00
DRY_STEP             01:00:00
ROUTING_STEP         0:00:10
INERTIAL_DAMPING     NONE
NORMAL_FLOW_LIMITED  BOTH
FORCE_MAIN_EQUATION  H-W
VARIABLE_STEP        0.75
LENGTHENING_STEP     0
MIN_SURFAREA         12.566
MAX_TRIALS           8
HEAD_TOLERANCE       0.005
SYS_FLOW_TOL         5
LAT_FLOW_TOL         5
THREADS              1

[EVAPORATION]
;;Data Source    Parameters
CONSTANT         0.0
DRY_ONLY         NO

[RAINGAGES]
;;Name           Format    Interval SCF      Source
RG1              INTENSITY 0:05     1.0      TIMESERIES Storm

[SUBCATCHMENTS]
;;Name           Rain Gage        Outlet           Area     %Imperv  Width    %Slope   CurbLen
S1               RG1              J1               4        30       400      1.5      0
S2               RG1              J2               6        60       600      1.0      0
S3               RG1              J4               8        45       700      1.0      0

[SUBAREAS]
;;Subcatchment   N-Imperv   N-Perv     S-Imperv   S-Perv     PctZero    RouteTo
S1               0.015      0.15       0.05       0.2        25         OUTLET
S2               0.015      0.15       0.05       0.2        25         OUTLET
S3               0.015      0.15       0.05       0.2        25         OUTLET

[INFILTRATION]
;;Subcatchment   MaxRate    MinRate    Decay      DryTime    MaxInfil
S1               3.0        0.5        4          7          0
S2               3.0        0.5        4          7          0
S3               3.0        0.5        4          7          0

[JUNCTIONS]
;;Name           Elevation  MaxDepth   InitDepth  SurDepth   Aponded
J1               100        8          0          0          0
J2               98         8          0          0          0
J3               96         8          0          0          0
J4               94         8          0          0          0
J5               99         8          0          0          0
J6               96.5       8          0          0          0

[OUTFALLS]
;;Name           Elevation  Type       Stage Data       Gated
O1               92         FREE                        NO

[CONDUITS]
;;Name           From Node        To Node          Length     Roughness  InOffset   OutOffset  InitFlow   MaxFlow
C1               J1               J2               400        0.013      0          0          0          0
C2               J2               J3               400        0.013      0          0          0          0
C3               J3               J4               400        0.013      0          0          0          0
C4               J4               O1               400        0.013      0          0          0          0
C5               J5               J2               300        0.013      0          0          0          0
C6               J6               J4               300        0.013      0          0          0          0

[XSECTIONS]
;;Link           Shape        Geom1            Geom2      Geom3      Geom4      Barrels
C1               CIRCULAR     1.5              0          0          0          1
C2               CIRCULAR     2.0              0          0          0          1
C3               CIRCULAR     2.0              0          0          0          1
C4               CIRCULAR     2.5              0          0          0          1
C5               CIRCULAR     1.25             0          0          0          1
C6               CIRCULAR     1.25             0          0          0          1

[INFLOWS]
;;SWMM5+ needs an inflow at every upstream end node: a small base flow.
;;Node           Constituent      Time Series      Type     Mfactor  Sfactor  Baseline Pattern
J1               FLOW             ""               FLOW     1.0      1.0      0.05
J5               FLOW             ""               FLOW     1.0      1.0      0.05
J6               FLOW             ""               FLOW     1.0      1.0      0.05

[TIMESERIES]
;;Name           Time       Value (in/h)
Storm            0:00       0.0
Storm            0:05       0.2
Storm            0:10       0.4
Storm            0:15       0.8
Storm            0:20       1.2
Storm            0:25       2.0
Storm            0:30       2.8
Storm            0:35       2.1
Storm            0:40       1.5
Storm            0:45       1.0
Storm            0:50       0.6
Storm            0:55       0.4
Storm            1:00       0.2
Storm            1:05       0.1
Storm            1:10       0.0

[REPORT]
INPUT      NO
CONTROLS   NO
SUBCATCHMENTS ALL
NODES ALL
LINKS ALL

[MAP]
DIMENSIONS 0 0 2000 1200
Units      Feet

[COORDINATES]
;;Node           X-Coord            Y-Coord
J1               100                900
J2               500                900
J3               900                900
J4               1300               900
J5               500                1150
J6               1300               1150
O1               1700               900

[Polygons]
;;Subcatchment   X-Coord            Y-Coord
S1               0                  400
S1               400                400
S1               400                800
S1               0                  800
S2               400                400
S2               900                400
S2               900                800
S2               400                800
S3               900                400
S3               1500               400
S3               1500               800
S3               900                800

[SYMBOLS]
;;Gage           X-Coord            Y-Coord
RG1              100                1100
