[TITLE]
Mirab demonstration network
Looped 3 x 3 grid fed by a pumped reservoir, with an elevated storage tank

[JUNCTIONS]
;ID              Elev            Demand          Pattern
 J1              20              0               PAT1
 J2              18              5               PAT1
 J3              16              5               PAT1
 J4              18              5               PAT1
 J5              15              8               PAT1
 J6              14              6               PAT1
 J7              16              4               PAT1
 J8              13              7               PAT1
 J9              12              5               PAT1

[RESERVOIRS]
;ID              Head            Pattern
 R1              30

[TANKS]
;ID              Elevation       InitLevel       MinLevel        MaxLevel        Diameter        MinVol          VolCurve        Overflow
 T1              60              4               1               8               15              0

[PIPES]
;ID              Node1           Node2           Length          Diameter        Roughness       MinorLoss       Status
 P1              J1              J2              300             200             120             0               Open
 P2              J2              J3              300             150             120             0               Open
 P3              J1              J4              300             200             120             0               Open
 P4              J2              J5              300             150             120             0               Open
 P5              J3              J6              300             100             120             0               Open
 P6              J4              J5              300             150             120             0               Open
 P7              J5              J6              300             150             120             0               Open
 P8              J4              J7              300             150             120             0               Open
 P9              J5              J8              300             100             120             0               Open
 P10             J6              J9              300             100             120             0               Open
 P11             J7              J8              300             100             120             0               Open
 P12             J8              J9              300             100             120             0               Open
 P13             J7              T1              200             200             120             0               Open

[PUMPS]
;ID              Node1           Node2           Parameters
 PU1             R1              J1              HEAD C1

[VALVES]
;ID              Node1           Node2           Diameter        Type            Setting         MinorLoss

[DEMANDS]

[EMITTERS]

[STATUS]

[PATTERNS]
;ID              Multipliers
 PAT1            0.6             0.5             0.45            0.45            0.5             0.7
 PAT1            1.0             1.3             1.4             1.3             1.2             1.15
 PAT1            1.1             1.05            1.0             1.0             1.1             1.3
 PAT1            1.4             1.3             1.1             0.9             0.8             0.7

[CURVES]
;ID              X-Value         Y-Value
;PUMP: single-point design curve
 C1              60              40

[CONTROLS]

[RULES]

[ENERGY]
 Global Efficiency 75
 Global Price      0
 Demand Charge     0

[QUALITY]
;Node            InitQual
 R1              1.0

[SOURCES]

[REACTIONS]
 Order Bulk      1
 Order Tank      1
 Order Wall      1
 Global Bulk     -0.5
 Global Wall     0

[MIXING]

[TIMES]
 Duration           24:00
 Hydraulic Timestep 1:00
 Quality Timestep   0:05
 Pattern Timestep   1:00
 Pattern Start      0:00
 Report Timestep    1:00
 Report Start       0:00
 Start ClockTime    12 am
 Statistic          NONE

[REPORT]
 Status          No
 Summary         No

[OPTIONS]
 Units              LPS
 Headloss           H-W
 Specific Gravity   1.0
 Viscosity          1.0
 Trials             200
 Accuracy           0.001
 Unbalanced         Continue 10
 Pattern            1
 Demand Multiplier  1.0
 Emitter Exponent   0.5
 Quality            CHLORINE mg/L
 Diffusivity        1.0
 Tolerance          0.01

[COORDINATES]
;Node            X-Coord         Y-Coord
 J1              1000            3000
 J2              2000            3000
 J3              3000            3000
 J4              1000            2000
 J5              2000            2000
 J6              3000            2000
 J7              1000            1000
 J8              2000            1000
 J9              3000            1000
 R1              0               3000
 T1              1000            0

[VERTICES]

[LABELS]

[BACKDROP]
 DIMENSIONS      -100            -100            3100            3100
 UNITS           Meters

[END]
