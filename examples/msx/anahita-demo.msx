[TITLE]
Chlorine consumption by organic carbon

[OPTIONS]
  AREA_UNITS M2
  RATE_UNITS HR
  SOLVER     RK5
  TIMESTEP   300
  RTOL       0.001
  ATOL       0.0001

[SPECIES]
  BULK CL2   MG             ;free chlorine
  BULK TOC   MG             ;total organic carbon

[COEFFICIENTS]
  CONSTANT kCl  0.05         ;chlorine consumption rate, L/mg/hr
  CONSTANT kOx  0.01         ;carbon oxidation rate, L/mg/hr

[PIPES]
  RATE  CL2  -kCl*CL2*TOC
  RATE  TOC  -kOx*CL2*TOC

[TANKS]
  RATE  CL2  -kCl*CL2*TOC
  RATE  TOC  -kOx*CL2*TOC

[QUALITY]
  GLOBAL TOC 1.5
  NODE   R1  CL2 1.2
  NODE   R1  TOC 1.5

[REPORT]
  NODES   ALL
  SPECIES CL2 YES
  SPECIES TOC YES
