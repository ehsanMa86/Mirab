[TITLE]
Mirab demonstration urban catchment with pollutants, groundwater and RDII

[OPTIONS]
FLOW_UNITS           CMS
INFILTRATION         HORTON
FLOW_ROUTING         DYNWAVE
LINK_OFFSETS         DEPTH
MIN_SLOPE            0
ALLOW_PONDING        NO
SKIP_STEADY_STATE    NO
START_DATE           01/01/2026
START_TIME           00:00:00
REPORT_START_DATE    01/01/2026
REPORT_START_TIME    00:00:00
END_DATE             01/01/2026
END_TIME             12:00:00
SWEEP_START          01/01
SWEEP_END            12/31
DRY_DAYS             5
REPORT_STEP          00:05:00
WET_STEP             00:01:00
DRY_STEP             01:00:00
ROUTING_STEP         0:00:05
INERTIAL_DAMPING     PARTIAL
NORMAL_FLOW_LIMITED  BOTH
FORCE_MAIN_EQUATION  H-W
VARIABLE_STEP        0.75
LENGTHENING_STEP     0
MIN_SURFAREA         1.167
MAX_TRIALS           8
HEAD_TOLERANCE       0.0015
SYS_FLOW_TOL         5
LAT_FLOW_TOL         5
THREADS              1

[EVAPORATION]
CONSTANT         0.0
DRY_ONLY         NO

[RAINGAGES]
;;Name           Format    Interval SCF      Source
RG1              INTENSITY 0:15     1.0      TIMESERIES Storm1

[SUBCATCHMENTS]
;;Name           Rain Gage        Outlet           Area     %Imperv  Width    %Slope   CurbLen
S1               RG1              J1               4        50       400      0.5      0
S2               RG1              J2               6        40       500      0.5      0
S3               RG1              J4               5        65       450      0.5      0

[SUBAREAS]
;;Subcatchment   N-Imperv   N-Perv     S-Imperv   S-Perv     PctZero    RouteTo
S1               0.012      0.15       1.5        5          25         OUTLET
S2               0.012      0.15       1.5        5          25         OUTLET
S3               0.012      0.15       1.5        5          25         OUTLET

[INFILTRATION]
;;Subcatchment   MaxRate    MinRate    Decay      DryTime    MaxInfil
S1               75         6          4          7          0
S2               75         6          4          7          0
S3               75         6          4          7          0

[AQUIFERS]
;;Name           Por    WP     FC     Ksat   Kslope Tslope ETu    ETs    Seep   Ebot   Egw    Umc
GW1              0.46   0.13   0.23   50     5      15     0.35   4      0.05   90     95     0.23

[GROUNDWATER]
;;Subcatchment   Aquifer  Node     Esurf  A1      B1   A2   B2   A3   Dsw  Egwt
S1               GW1      J1       101    0.0005  2    0    0    0    0    94

[GWF]
;;Subcatchment   Flow     Expression
S1               DEEP     0.00001 * Hgw

[JUNCTIONS]
;;Name           Elevation  MaxDepth   InitDepth  SurDepth   Aponded
J1               100        3          0          0          0
J2               99         3          0          0          0
J3               98         3          0          0          0
J4               98.5       3          0          0          0
J5               97         3          0          0          0

[OUTFALLS]
;;Name           Elevation  Type       Stage Data       Gated
O1               96         FREE                        NO

[CONDUITS]
;;Name           From Node        To Node          Length     Roughness  InOffset   OutOffset  InitFlow   MaxFlow
C1               J1               J2               150        0.013      0          0          0          0
C2               J2               J3               150        0.013      0          0          0          0
C3               J4               J3               120        0.013      0          0          0          0
C4               J3               J5               150        0.013      0          0          0          0
C5               J5               O1               100        0.013      0          0          0          0

[XSECTIONS]
;;Link           Shape        Geom1            Geom2      Geom3      Geom4      Barrels
C1               CIRCULAR     0.6              0          0          0          1
C2               CIRCULAR     0.75             0          0          0          1
C3               CIRCULAR     0.6              0          0          0          1
C4               CIRCULAR     0.9              0          0          0          1
C5               CIRCULAR     0.9              0          0          0          1

[POLLUTANTS]
;;Name           Units  Crain  Cgw    Crdii  Kdecay SnowOnly Co-Pollutant Co-Frac Cdwf   Cinit
TSS              MG/L   0      0      0      0      NO       *            0       120    0
Lead             UG/L   0      0      0      0      NO       TSS          0.2     0      0

[LANDUSES]
;;Name           SweepInterval Availability LastSweep
Residential      0             0            0
Commercial       7             0.4          3

[COVERAGES]
;;Subcatchment   Land Use         Percent
S1               Residential      80       Commercial  20
S2               Residential      100
S3               Commercial       70       Residential 30

[LOADINGS]
;;Subcatchment   Pollutant        Buildup
S1               TSS              10
S3               TSS              15       Lead        0.5

[BUILDUP]
;;Land Use       Pollutant        Function   Coeff1     Coeff2     Coeff3     Per Unit
Residential      TSS              SAT        50         0          2          AREA
Residential      Lead             NONE       0          0          0          AREA
Commercial       TSS              SAT        80         0          1.5        AREA
Commercial       Lead             NONE       0          0          0          AREA

[WASHOFF]
;;Land Use       Pollutant        Function   Coeff1     Coeff2     SweepRmvl  BmpRmvl
Residential      TSS              EXP        0.1        1.5        0          0
Residential      Lead             EMC        5          0          0          0
Commercial       TSS              EXP        0.2        1.5        50         0
Commercial       Lead             EMC        10         0          0          0

[TREATMENT]
;;Node           Pollutant        Function
J5               TSS              R = 0.3
J5               Lead             R = 0.5 * R_TSS

[INFLOWS]
;;Node           Constituent      Time Series      Type     Mfactor  Sfactor  Baseline Pattern
J2               FLOW             Inflow1          FLOW     1.0      1.0      0.01
J2               TSS              ""               CONCEN   1.0      1.0      50

[DWF]
;;Node           Constituent      Baseline   Patterns
J1               FLOW             0.005      ""         ""         "Hourly1"
J1               TSS              150

[HYDROGRAPHS]
;;Hydrograph     Month/Gage Response R        T        K
UH1              RG1
UH1              ALL        SHORT    0.05     1        2
UH1              ALL        MEDIUM   0.02     3        3

[RDII]
;;Node           Unit Hydrograph  Sewer Area
J4               UH1              2

[TIMESERIES]
;;Name           Time       Value
Storm1           0:00       0
Storm1           0:15       6
Storm1           0:30       18
Storm1           0:45       42
Storm1           1:00       25
Storm1           1:15       12
Storm1           1:30       6
Storm1           1:45       2
Storm1           2:00       0
;
Inflow1          0:00       0
Inflow1          1:00       0.05
Inflow1          3:00       0.02
Inflow1          6:00       0

[PATTERNS]
;;Name           Type       Multipliers
Hourly1          HOURLY     0.6   0.5   0.4   0.4   0.5   0.8   1.2   1.5   1.4   1.2   1.1   1.0
Hourly1                     1.0   1.0   1.1   1.2   1.3   1.4   1.3   1.2   1.1   1.0   0.8   0.7

[REPORT]
INPUT      NO
CONTROLS   NO
SUBCATCHMENTS ALL
NODES ALL
LINKS ALL

[MAP]
DIMENSIONS 0 0 1000 800
Units      Meters

[COORDINATES]
;;Node           X-Coord    Y-Coord
J1               150        650
J2               350        600
J3               550        450
J4               400        300
J5               700        400
O1               900        350

[VERTICES]

[POLYGONS]
;;Subcatchment   X-Coord    Y-Coord
S1               50         750
S1               250        750
S1               250        600
S1               50         600
S2               250        750
S2               500        750
S2               500        550
S2               250        550
S3               250        450
S3               450        450
S3               450        200
S3               250        200

[SYMBOLS]
;;Gage           X-Coord    Y-Coord
RG1              100        790
